# Copy this file to .env (already gitignored) and fill in real values.
# .env is loaded automatically by config.py via python-dotenv.

# Any private, unpredictable string. Used by Flask-Login to sign session
# cookies -- do not commit a real value, and do not reuse the same value
# across developers/environments if you can avoid it.
SECRET_KEY=

# Shared MySQL database credentials (see CircusCircusLimes_MySQL_Team_Setup_Guide).
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=circuscircuslimes
